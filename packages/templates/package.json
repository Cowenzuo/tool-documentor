{
  "name": "@documentor/templates",
  "version": "0.1.0",
  "private": true,
  "description": "Documentor 模板系统：按 uuid 扫描与解析模板目录、结构模板加载与实例化、样式映射定位",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./style-keys": {
      "import": "./src/style-keys.ts",
      "require": "./dist/style-keys.js"
    },
    "./style-rules": {
      "import": "./src/style-rules.ts",
      "require": "./dist/style-rules.js"
    }
  },
  "dependencies": {
    "@documentor/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  }
}
