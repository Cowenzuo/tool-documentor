{
  "name": "@documentor/docx",
  "version": "0.1.0",
  "private": true,
  "description": "Documentor DOCX 导出：序列化器把文档树转成写入指令，writer 把指令打成 OOXML 包",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@documentor/core": "workspace:*",
    "@documentor/templates": "workspace:*",
    "@documentor/postprocess": "workspace:*",
    "jszip": "^3.10.1",
    "mmd2vsdx": "link:../../../tool-mmd2vsdx"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  }
}
