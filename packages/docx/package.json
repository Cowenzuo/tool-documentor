{
  "name": "@documentor/docx",
  "version": "0.1.0",
  "private": true,
  "description": "Documentor DOCX 导出：DocxSerializer（树→写入指令）+ DocxWriter（指令→OOXML 打包）",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@documentor/core": "workspace:*",
    "@documentor/templates": "workspace:*",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "set NODE_OPTIONS=--experimental-sqlite&& vitest run",
    "build": "tsc -p tsconfig.build.json"
  }
}
