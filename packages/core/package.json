{
  "name": "@documentor/core",
  "version": "0.1.0",
  "private": true,
  "description": "Documentor 核心：文档树/内容块数据模型、SQLite 工程存储、表格与块转换",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./tree": {
      "import": "./src/tree.ts",
      "require": "./dist/tree.js"
    },
    "./blocks": {
      "import": "./src/blocks.ts",
      "require": "./dist/blocks.js"
    },
    "./block-convert": {
      "import": "./src/block-convert.ts",
      "require": "./dist/block-convert.js"
    },
    "./table-merge": {
      "import": "./src/table-merge.ts",
      "require": "./dist/table-merge.js"
    },
    "./table-limits": {
      "import": "./src/table-limits.ts",
      "require": "./dist/table-limits.js"
    },
    "./mermaid-source": {
      "import": "./src/mermaid-source.ts",
      "require": "./dist/mermaid-source.js"
    },
    "./time": {
      "import": "./src/time.ts",
      "require": "./dist/time.js"
    },
    "./idgen": {
      "import": "./src/idgen.ts",
      "require": "./dist/idgen.js"
    },
    "./anchor": {
      "import": "./src/anchor.ts",
      "require": "./dist/anchor.js"
    },
    "./store": {
      "import": "./src/store.ts",
      "require": "./dist/store.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
