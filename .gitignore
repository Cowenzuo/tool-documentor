# dependencies
node_modules/

# build outputs（库 dist 与桌面 out 均为编译产物，clone 后由 dev/build 自动重建）
out/
dist/
release/
*.tsbuildinfo
# ensure-libs 的库构建指纹（启动时据此跳过无谓重编，不入库）
.libs-build-hash

# 临时/探针产物
.e2e-workspace/
.probe/
.tmp*
*~
# 统一临时目录（E2E 工作区、冒烟导出、打包调试等；不放系统临时目录）
temp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# local
*.local
# 本机开发模式标记：存在时开始脚本会走开发版而非发布版（见 scripts/start-documentor.cjs）
.dev-mode
# 功能立项备忘不进仓库（维护者本机保存）
docs/待讨论功能备忘.md
# 本机脚本：单测、E2E 探针与冒烟、Word 核对脚本、开发工具
localscripts/

# 外部模板资产：模板不在本仓库（版权分发边界），也不在本仓库建目录。
# 真身在仓库外，由同级目录 tool-documentor-template 单独管理（结构与样式两个模板包）。
# 这里只兜住历史遗留的本地目录名，避免误入版本库。
localtest/
