{
  "name": "tool-rwdoc",
  "version": "0.1.2-alpha1",
  "private": true,
  "license": "MIT",
  "description": "Documentor：模板驱动的结构化 DOCX 文档编辑器，Node.js 与 Electron 重写版",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build:libs": "pnpm --filter @documentor/core build && pnpm --filter @documentor/templates build && pnpm --filter @documentor/postprocess build && pnpm --filter @documentor/docx build",
    "build:libs:mark": "pnpm build:libs && node scripts/ensure-libs.cjs --mark",
    "ensure:libs": "node scripts/ensure-libs.cjs",
    "dev": "node scripts/ensure-libs.cjs && pnpm --filter @documentor/desktop dev",
    "build": "pnpm build:libs && pnpm --filter @documentor/desktop build",
    "start": "pnpm --filter @documentor/desktop start",
    "package:dir": "pnpm build && pnpm --filter @documentor/desktop package:dir",
    "package": "pnpm build && pnpm --filter @documentor/desktop package",
    "verify:package": "pnpm package:dir && node scripts/verify-package.cjs",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm build && node scripts/check-upstream.cjs",
    "verify:upstream": "node scripts/check-upstream.cjs --strict",
    "test:local": "set NODE_OPTIONS=--experimental-sqlite&& vitest run -c localscripts/vitest.config.ts",
    "check:locks": "node localscripts/lock-check.cjs",
    "check:open": "node localscripts/open-check.cjs",
    "check:open:ui": "node localscripts/e2e/run.cjs --fixture localscripts/e2e/fixture-open.cjs --probe localscripts/e2e/probe-open.cjs",
    "check:structure": "node localscripts/structure-check.cjs",
    "check:styles": "node localscripts/style-check.cjs",
    "check:ui": "node localscripts/e2e/run.cjs"
  }
}
